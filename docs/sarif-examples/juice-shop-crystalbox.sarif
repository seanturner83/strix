                  "endLine": 51,
                  "snippet": {
                    "text": "export const cutOffPoisonNullByte = (str: string) => {\n  const nullByte = '%00'\n  if (utils.contains(str, nullByte)) {\n    return str.substring(0, str.indexOf(nullByte))\n  }\n  return str\n}"
